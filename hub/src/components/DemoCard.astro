---
type Props = {
	title: string;
	description: string;
	slug: string | null;
	status: "planned" | "live";
};

const { title, description, slug, status } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const href = status === "live" && slug ? `${base}${slug}/` : null;
---

<div class="card card-flat">
	<div class="card-head">
		<h3>{title}</h3>
		<span class={`status status-${status}`}>{status === "live" ? "live" : "coming soon"}</span>
	</div>
	<p>{description}</p>
	{href ? <a class="btn" href={href}>Play</a> : null}
</div>

<style>
	.card-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-sm);
		margin-bottom: var(--space-xs);
	}

	h3 {
		margin: 0;
		font-size: var(--text-md);
		color: var(--fg);
	}

	p {
		margin: 0 0 var(--space-sm) 0;
		color: var(--fg-muted);
		font-size: var(--text-sm);
		line-height: 1.5;
	}

	.status {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		padding: 1px 6px;
		border-radius: var(--radius);
		border: 1px solid var(--border);
	}

	.status-planned {
		color: var(--fg-muted);
		background: var(--bg-alt);
	}

	.status-live {
		color: var(--fg);
		background: var(--bg-alt);
	}
</style>
