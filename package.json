{
  "name": "echo",
  "private": true,
  "type": "module",
  "workspaces": ["subsystems/*", "hub"],
  "scripts": {
    "hub:dev": "cd hub && bun run dev",
    "hub:build": "cd hub && bun run build",
    "hub:preview": "cd hub && bun run preview",
    "hub:typecheck": "cd hub && bun run typecheck",
    "subsystems:build": "for d in subsystems/*/; do [ -f \"$d/package.json\" ] && (cd \"$d\" && bun run build); done; true",
    "main:build": "if [ -f main/package.json ]; then cd main && bun run build; fi",
    "build:all": "bun run hub:build && bun run subsystems:build && bun run main:build",
    "serve:hub": "cd hub && bun run serve",
    "serve:arena": "cd subsystems/arena && bun run serve",
    "serve:bestiary": "cd subsystems/bestiary && bun run serve",
    "serve:dungeon-walk": "cd subsystems/dungeon-walk && bun run serve",
    "serve:loot": "cd subsystems/loot && bun run serve",
    "serve:progress": "cd subsystems/progress && bun run serve",
    "test": "bun test",
    "typecheck": "bun run hub:typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.6.0"
  }
}
